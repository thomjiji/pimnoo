{
  "name": "pimono",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Pi extensions managed as one umbrella package",
  "keywords": ["pi-package"],
  "license": "MIT",
  "type": "module",
  "files": [
    "README.md",
    "extensions",
    "package.json",
    "scripts",
    "test"
  ],
  "pi": {
    "extensions": ["./extensions"]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts && node test/smoke.mjs",
    "test:unit": "node --experimental-strip-types --test test/*.test.ts",
    "test:smoke": "node test/smoke.mjs",
    "typecheck": "node scripts/typecheck.mjs"
  }
}
